{
  "manifest_version": 3,
  "name": "MDB Filtering Tool",
  "version": "1.0.0",
  "description": "Automatic filtering of non-academic messages in VU's Moderated Discussion Board",
  "permissions": [
    "scripting",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MDB Filtering Tool"
  },
  "options_page": "options.html"
}
